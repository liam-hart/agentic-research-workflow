#!/usr/bin/env python3
"""bench-lock take|release|status|wait for a lock on a shared checkout that one live application
(for example a game-engine editor) holds, so only one agent session at a time switches branches or edits there.

  bench-lock take --purpose "..." [--branch B] [--owner O]   take the lock atomically (exit 1 if another chat holds it)
  bench-lock wait --purpose "..." [--timeout S] [--poll S]   block until the bench is free, then take it
                                                             (run with run_in_background: the exit is the notification)
  bench-lock release [--force]                               delete the lock if this chat holds it; prints return_to
  bench-lock status                                          free / mine / held by another (exit 1)

Identity is $CLAUDE_CODE_SESSION_ID plus `chat-name --get`. The lock lives at the bench root (main worktree),
found through the shared .git, so it works from any worktree. Never runs unity, git checkout, or git switch."""
import argparse, os, subprocess, sys, time
from datetime import datetime, timezone

def git(*a, cwd=None):
    r = subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""

def bench_root():
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common.endswith("/.git"):
        sys.exit("bench-lock: run inside the repository or one of its worktrees")
    return common[:-5]

ROOT = bench_root()
LOCK = os.path.join(ROOT, ".bench-lock")
SID = os.environ.get("CLAUDE_CODE_SESSION_ID", "")

def chat_name():
    r = subprocess.run(["chat-name", "--get"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""

def read():
    try:
        text = open(LOCK).read()
    except FileNotFoundError:
        return None
    f = {}
    for line in text.splitlines():
        k, _, v = line.partition(":")
        if v: f[k.strip().lower()] = v.strip()
    return f, text

def mine(f):
    s = f.get("session", "").lower()
    return bool(s) and len(s) >= 8 and SID.lower().startswith(s)

def take(a):
    if not SID: sys.exit("bench-lock: CLAUDE_CODE_SESSION_ID not set")
    name = chat_name()
    if not name and not getattr(take, "warned", False):
        take.warned = True; print("bench-lock: warning: no chat name set; run `chat-name \"...\"` so the status line can show who holds it", file=sys.stderr)
    cur = read()
    if cur and mine(cur[0]):
        print("bench already yours:\n" + cur[1], end=""); return 0
    body = (f"owner: {a.owner or 'claude session ' + SID[:8]}\nsession: {SID}\nname: {name}\n"
            f"branch: {a.branch or git('branch', '--show-current') or '(detached)'}\npurpose: {a.purpose}\n"
            f"acquired: {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\n"
            f"return_to: {git('branch', '--show-current', cwd=ROOT) or '(detached)'} {git('rev-parse', '--short', 'HEAD', cwd=ROOT)}\n")
    try:
        fd = os.open(LOCK, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)  # atomic check-and-write
    except FileExistsError:
        return 1
    with os.fdopen(fd, "w") as fh: fh.write(body)
    print("bench taken:\n" + body, end="")
    dirty = "\n".join(l for l in git("status", "--short", cwd=ROOT).splitlines() if not l.endswith(".bench-lock"))
    if dirty: print("note: bench tree is not clean:\n" + dirty)
    return 0

def release(a):
    cur = read()
    if not cur: print("bench already free"); return 0
    f, text = cur
    if not mine(f) and not a.force:
        print("bench-lock: not your lock; held by " + (f.get("name") or f.get("owner", "?")) + ". Use --force only if the bench owner says it is abandoned.", file=sys.stderr)
        return 1
    os.remove(LOCK)
    print("released. Return the bench to: " + f.get("return_to", "(unknown; read git reflog)"))
    print("Check `git status --short` and `git reflog -3` before any checkout; this command did not switch branches.")
    return 0

def status(a):
    cur = read()
    if not cur: print("free"); return 0
    f, text = cur
    print(("yours" if mine(f) else "held by another chat") + ":\n" + text, end="")
    return 0 if mine(f) else 1

def wait(a):
    end = time.time() + a.timeout if a.timeout else None
    last = None
    while True:
        rc = take(a)
        if rc == 0: return 0
        cur = read()
        who = (cur[0].get("name") or cur[0].get("owner", "?")) if cur else "?"
        if who != last: print(f"waiting: bench held by {who}", flush=True); last = who
        if end and time.time() > end:
            print("bench-lock: timed out waiting", file=sys.stderr); return 3
        time.sleep(a.poll)

p = argparse.ArgumentParser(prog="bench-lock")
sub = p.add_subparsers(dest="cmd", required=True)
for n in ("take", "wait"):
    s = sub.add_parser(n); s.add_argument("--purpose", required=True); s.add_argument("--branch"); s.add_argument("--owner")
    if n == "wait": s.add_argument("--timeout", type=int, default=0); s.add_argument("--poll", type=int, default=10)
sub.add_parser("release").add_argument("--force", action="store_true")
sub.add_parser("status")
a = p.parse_args()
rc = {"take": take, "wait": wait, "release": release, "status": status}[a.cmd](a)
if rc == 1 and a.cmd in ("take", "wait"):
    print("bench taken by another chat:\n" + (read() or ("", ""))[1], end="")
sys.exit(rc)
